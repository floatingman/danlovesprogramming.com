---
import { profile } from '../data/profile';
---

<section id="experience">
  <h2>Experience</h2>
  <ol class="experience-list">
    {profile.experience.map((entry) => (
      <li>
        <h3>{entry.role} · {entry.company}</h3>
        <p class="muted">{entry.start} – {entry.end ?? 'Present'}</p>
        <p>{entry.summary}</p>
      </li>
    ))}
  </ol>
</section>
