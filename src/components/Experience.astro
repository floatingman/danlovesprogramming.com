---
import { profile } from '../data/profile';
---

<section id="experience">
  <h2>Experience</h2>
  <ol class="experience-list">
    {profile.experience.map((entry) => (
      <li>
        <strong>{entry.role}</strong> · {entry.company}
        <span class="muted"> · {entry.start} – {entry.end ?? 'Present'}</span>
      </li>
    ))}
  </ol>
  <p class="muted">Full details on <a href={profile.linkedinUrl}>LinkedIn</a>.</p>
</section>
